#!/bin/sh
# Runs at login on the test image. Times some CPU-heavy work and launching every
# app and preference panel, and reports each result as a "WL" line on the
# second serial port, which the host records.

out=/dev/ports/pc_serial1
[ -e "$out" ] || out=/dev/ports/pc_serial0
report() { echo "WL $*" > "$out"; }
now_ms() { echo $(( $(date +%s%N) / 1000000 )); }
have() { command -v "$1" >/dev/null 2>&1; }
run_for() {
	# run_for <seconds> <command...>: like timeout(1), which may be missing.
	if have timeout; then timeout "$@"; else shift; "$@"; fi
}

report "start uname=$(uname -a | tr ' ' _)"
report "date_ns_check $(date +%s%N)"

packages=/boot/system/packages

start=$(now_ms)
cat "$packages"/*.hpkg | head -c 200000000 | sha256sum >/dev/null
report "sha256_200MB_ms $(( $(now_ms) - start ))"

if have xz; then
	start=$(now_ms)
	cat "$packages"/*.hpkg | head -c 50000000 | xz -1 -T1 -c >/dev/null
	report "xz1_50MB_ms $(( $(now_ms) - start ))"
fi

start=$(now_ms)
i=0; sum=0
while [ $i -lt 200000 ]; do sum=$(( sum + i * i % 7 )); i=$(( i + 1 )); done
report "shell_loop_200k_ms $(( $(now_ms) - start ))"

# Launch each app, wait for its first window, then quit it.
launched=0; windowed=0; total_start=$(now_ms)
for app in /boot/system/apps/* /boot/system/preferences/*; do
	[ -f "$app" ] && [ -x "$app" ] || continue
	name=$(basename "$app")
	case "$name" in
		Installer|FirstBootPrompt) continue ;;
	esac
	sig=$(catattr -d BEOS:APP_SIG "$app" 2>/dev/null)
	[ -n "$sig" ] || sig=$name
	start=$(now_ms)
	"$app" >/dev/null 2>&1 &
	pid=$!
	launched=$(( launched + 1 ))
	result=timeout
	while [ $(( $(now_ms) - start )) -lt 20000 ]; do
		if ! kill -0 "$pid" 2>/dev/null; then result=exited; break; fi
		count=$(run_for 5 hey "$sig" count Window 2>/dev/null | sed -n 's/.*result: *\([0-9][0-9]*\).*/\1/p')
		if [ -n "$count" ] && [ "$count" -ge 1 ]; then result=window; break; fi
		sleep 0.2
	done
	elapsed=$(( $(now_ms) - start ))
	[ "$result" = window ] && windowed=$(( windowed + 1 ))
	report "app $name $result ${elapsed}ms"
	run_for 5 hey "$sig" quit >/dev/null 2>&1
	sleep 0.5
	kill "$pid" 2>/dev/null
	sleep 0.2
	kill -9 "$pid" 2>/dev/null
done
report "apps launched=$launched windowed=$windowed total_ms=$(( $(now_ms) - total_start ))"
report "done"
